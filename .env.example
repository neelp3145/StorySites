# App
APP_NAME=StorySites
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Database
# Cursor hosting sets DATABASE_URL when cursor-app.json declares postgres.
# For Supabase self-hosting, use:
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.byyeypetaepfkomadvbm.supabase.co:5432/postgres
# Local default (no env): sqlite+pysqlite:///./storysites.db

# CORS — comma-separated origins
CORS_ORIGINS=https://storysite-entry.netlify.app,http://127.0.0.1:3847,http://localhost:3847

# Admin session login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Notification email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=StorySites <noreply@example.com>
NOTIFY_TO=
SMTP_USE_TLS=true

RATE_LIMIT=10/minute
