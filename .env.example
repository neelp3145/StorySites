# App
APP_NAME=StorySites API
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Supabase project: https://byyeypetaepfkomadvbm.supabase.co
# Project Settings → Database → Database password (or reset it there)
# Direct connection (simple for local alembic / uvicorn):
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-DATABASE-PASSWORD]@db.byyeypetaepfkomadvbm.supabase.co:5432/postgres
# Transaction pooler (preferred when deployed) — copy URI from Dashboard and change scheme to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://postgres.byyeypetaepfkomadvbm:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# CORS — comma-separated origins
CORS_ORIGINS=https://storysite-entry.netlify.app,http://localhost:5500,http://127.0.0.1:5500

# Admin session login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Notification email (SMTP). Works with Resend, Gmail App Passwords, etc.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=StorySites <onboarding@resend.dev>
NOTIFY_TO=you@example.com
SMTP_USE_TLS=true

# Rate limit for public inquiry endpoint
RATE_LIMIT=10/minute
